# --- Telegram (create a bot with @BotFather, then send /start to it to see your chat id) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=1318404489
MIN_CONFIDENCE_TO_POST=0
# --- Crypto (Binance public data; a key is optional) ---
BINANCE_BASE=https://data-api.binance.vision
BINANCE_API_KEY=
CRYPTO_TOP_N=200
# --- Forex: yfinance (keyless, default) or twelvedata ---
FOREX_PROVIDER=yfinance
TWELVEDATA_API_KEY=
# --- Optional AI (any OpenAI-compatible endpoint) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# --- Strategy / runtime ---
RR=3.0
SCAN_MINUTES=15
UNIVERSE_REFRESH_HOURS=6
MAX_CONFIRM_AGE_BARS=6
ENABLE_SCHEDULER=1
DB_PATH=signals.db

# Postgres (Neon) for persistence; SQLite file used when empty
DATABASE_URL=
TELEGRAM_MODE=auto
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_URL=
SCAN_WORKERS=4
